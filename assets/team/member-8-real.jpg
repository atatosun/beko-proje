	list-style-type: none;
	padding-inline-start: 0;
	margin-block-start: 0;
	margin-block-end: 0;
	display: flex;
	flex-wrap: wrap;
}

.oxel-breadcrumb ol li {
	padding: 4px;
	/* color: grey; */
}

.oxel-breadcrumb ol li a {
	/* color: blue; */
}

.oxel-breadcrumb ol li:not(:last-child) a {
	margin-right: 4px;
}

.oxel-breadcrumb ol li:last-child span:last-child {
	display: none;
}</style>
